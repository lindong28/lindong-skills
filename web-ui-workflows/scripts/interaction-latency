#!/usr/bin/env python3
"""量一次**操作**让用户等了多久：从他动手那一刻，到他要的那个东西**看得见地**出现在屏幕上。
Run --help for inputs, output and evidence boundaries.
"""

from __future__ import annotations

import argparse
import json
import time
import math
import shutil
import subprocess
import sys
import uuid

EXIT_OK, EXIT_SLOW, EXIT_INSTRUMENT, EXIT_UNRESOLVED = 0, 1, 2, 3


class InstrumentError(RuntimeError):
    """一切"这次没量成"。绝不能与 EXIT_SLOW 混。"""


class Unresolved(RuntimeError):
    """读数不可信，但不是仪器坏了。"""


# 装仪器。必须短：只注册监听器并立刻返回，不在 eval 里等待任何东西。
INSTALL = r"""
((key, targetSel, clickSel, untilText, anyChange, token) => {
  const target = () => document.querySelector(targetSel);
  // 内容签名**不含路径**：点击后立刻 pushState 而内容 800 ms 后才到的页面，
  // 把路径拼进签名会让终点在两帧后就成立。路径只作诊断字段。
  const textOf = () => { const t = target(); return t === null ? null : (t.innerText || ''); };
  // 已渲染、非退化、且与视口有非空交集。innerText 在目标自身未渲染时按规范回退为
  // 全部后代文本，所以"文本变了"必须叠上这一层才等于"用户看见了"。
  const onScreen = () => {
    const t = target();
    if (t === null) return false;
    const r = t.getBoundingClientRect();
    if (!(r.width > 0 && r.height > 0)) return false;
    if (typeof t.checkVisibility === 'function' && !t.checkVisibility(
          {checkOpacity: true, checkVisibilityCSS: true})) return false;
    const vw = document.documentElement.clientWidth, vh = document.documentElement.clientHeight;
    return r.right > 0 && r.bottom > 0 && r.left < vw && r.top < vh;
  };
  // innerText owns substring/whitespace semantics. Bind its non-space characters
  // back to text-node offsets; never change Selection or substitute element boxes.
  const fold = text => text.normalize('NFKD').toUpperCase().replace(/\s/g, '');
  const textOnScreen = now => {
    const positions = [];
    let source = '';
    const walker = document.createTreeWalker(target(), NodeFilter.SHOW_TEXT);
    let node;
    while ((node = walker.nextNode())) {
      const parent = node.parentElement;
      if (!parent || getComputedStyle(parent).visibility !== 'visible') continue;
      const range = document.createRange();
      range.selectNodeContents(node);
      if (!range.getClientRects().length) continue;
      let offset = 0;
      for (const char of node.data) {
        const value = fold(char);
        for (let i = 0; i < value.length; i++) positions.push({node, start: offset, end: offset + char.length});
        source += value;
        offset += char.length;
      }
    }
    // An unbound rendering must not yield a plausible latency from a container.
    if (source !== fold(now)) return false;
    const visible = (node, start, end) => {
      const range = document.createRange();
      range.setStart(node, start); range.setEnd(node, end);
      for (const rect of range.getClientRects()) {
        let left = Math.max(0, rect.left), top = Math.max(0, rect.top);
        let right = Math.min(document.documentElement.clientWidth, rect.right);
        let bottom = Math.min(document.documentElement.clientHeight, rect.bottom);
        for (let e = node.parentElement; e; e = e.parentElement) {
          const css = getComputedStyle(e), box = e.getBoundingClientRect();
          // client dimensions are local CSS pixels; Range/box use viewport pixels.
          const sx = e.offsetWidth ? box.width / e.offsetWidth : 1;
          const sy = e.offsetHeight ? box.height / e.offsetHeight : 1;
          if (Number(css.opacity) === 0) return false;
          if (css.overflowX !== 'visible') {
            left = Math.max(left, box.left + e.clientLeft * sx);
            right = Math.min(right, box.left + (e.clientLeft + e.clientWidth) * sx);
          }
          if (css.overflowY !== 'visible') {
            top = Math.max(top, box.top + e.clientTop * sy);
            bottom = Math.min(bottom, box.top + (e.clientTop + e.clientHeight) * sy);
          }
        }
        if (right > left && bottom > top) return true;
      }
      return false;
    };
    for (let at = now.indexOf(untilText); at !== -1; at = now.indexOf(untilText, at + 1)) {
      const start = fold(now.slice(0, at)).length;
      const end = start + fold(untilText).length;
      if (start === end) continue;
      const segments = [];
      for (const pos of positions.slice(start, end)) {
        const last = segments[segments.length - 1];
        if (last && last.node === pos.node) last.end = pos.end;
        else segments.push({...pos});
      }
      if (segments.length && segments.every(p => visible(p.node, p.start, p.end))) return true;
    }
    return false;
  };
  let beforeVisible;
  let before = textOf();
  if (before === null) return JSON.stringify({error: 'target-missing'});

  const s = {token: token, t0: null, changed_at: null, painted_at: null,
             before_len: before.length, path_before: location.pathname + location.search,
             path_at_finish: null, hit: null, done: false, gave_up: false};
  window[key] = s;

  const satisfied = () => {
    const now = textOf();
    if (now === null) return false;
    const becameVisible = !beforeVisible && onScreen();
    if (now === before && !(anyChange && becameVisible)) return false;
    if (!anyChange && untilText && now.indexOf(untilText) === -1) return false;
    return anyChange ? onScreen() : textOnScreen(now);
  };
  const onDown = (ev) => {
    // 点击可能落在 sticky header / overlay / 空处，而 document 上的监听器照样记下它。
    const path = typeof ev.composedPath === 'function' ? ev.composedPath() : [];
    const want = document.querySelector(clickSel);
    s.hit = (want !== null && path.indexOf(want) !== -1);
    s.t0 = performance.now();
    // 基线属于实际操作起点；安装后为点击做的scrollintoview不是用户操作结果。
    before = textOf();
    beforeVisible = onScreen();
    s.before_len = before === null ? 0 : before.length;
    if (!anyChange && untilText && before !== null && before.includes(untilText)) {
      s.reason = 'until_text_preexists';
      s.gave_up = true;
      return;
    }
    const finish = () => {
      s.changed_at = performance.now();
      s.path_at_finish = location.pathname + location.search;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        s.painted_at = performance.now();
        s.done = true;
      }));
    };
    const poll = () => {
      if (s.changed_at !== null) return;
      if (satisfied()) { finish(); return; }
      requestAnimationFrame(poll);
    };
    requestAnimationFrame(poll);
  };
  document.addEventListener('pointerdown', onDown, {capture: true, once: true});
  return JSON.stringify({installed: true, token: token});
})(KEY, TARGET_SEL, CLICK_SEL, UNTIL_TEXT, ANY_CHANGE, TOKEN)
"""


def run(cmd: list[str], timeout: int = 120) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def unquote_eval(raw: str) -> object:
    """agent-browser 把 eval 结果作为带引号的 JSON 字符串回显。"""
    text = raw.strip().splitlines()[-1].strip() if raw.strip() else ""
    if not text:
        raise InstrumentError("eval 无输出")
    try:
        once = json.loads(text)
    except json.JSONDecodeError as exc:
        raise InstrumentError(f"eval 输出不可解析: {text[:200]}") from exc
    return json.loads(once) if isinstance(once, str) else once


def as_dict(value: object, what: str) -> dict:
    """`null` / 布尔 / 数组都能无错通过 json.loads，必须显式拒绝。"""
    if not isinstance(value, dict):
        raise InstrumentError(f"{what} 读数形状不对（拿到 {type(value).__name__}）")
    return value


def finite(value: object, what: str) -> float:
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        raise InstrumentError(f"{what} 不是数（拿到 {value!r}）")
    number = float(value)
    if number != number or number in (float("inf"), float("-inf")):
        raise InstrumentError(f"{what} 不是有限数（{value!r}）")
    return number


class Probe:
    def __init__(self, session: str, url: str, args: argparse.Namespace) -> None:
        self.session = session
        self.url = url
        self.args = args
        # 页面代码可能恰好用了 `window.__il`；随机私钥让碰撞不再可能。
        self.key = "__il_" + uuid.uuid4().hex[:12]
        self.deadline: float | None = None

    def ab(self, *argv: str, timeout: int = 120) -> subprocess.CompletedProcess:
        if self.deadline is not None:
            remaining = self.deadline - time.monotonic()
            if remaining <= 0:
                raise Unresolved("measurement_timeout")
            timeout = min(timeout, remaining)
        return run(["agent-browser", "--session", self.session, *argv], timeout=timeout)

    def evaluate(self, script: str) -> object:
        proc = self.ab("eval", script)
        if proc.returncode != 0:
            raise InstrumentError(f"eval 失败: {proc.stderr.strip()[:200]}")
        return unquote_eval(proc.stdout)

    def open_url(self) -> None:
        if self.ab("open", self.url).returncode != 0:
            raise InstrumentError(f"打不开 {self.url}")

    def set_viewport(self, w: int, h: int) -> None:
        if self.ab("set", "viewport", str(w), str(h)).returncode != 0:
            raise InstrumentError(f"set viewport {w}x{h} 失败")

    def confirm_viewport(self, w: int, h: int) -> None:
        """读回实测值。设失败时它会静默沿用默认 viewport，而报告照写请求值。"""
        got = as_dict(
            self.evaluate(
                "JSON.stringify({w: document.documentElement.clientWidth,"
                " h: document.documentElement.clientHeight})"
            ),
            "viewport",
        )
        # 滚动条会吃掉几像素，给一点余量；数量级不对才是"没设上"。
        if (abs(finite(got.get("w"), "viewport.w") - w) > 40
                or abs(finite(got.get("h"), "viewport.h") - h) > 40):
            raise InstrumentError(
                f"viewport 没设成功：请求 {w}x{h}，实测 {got.get('w')}x{got.get('h')}"
            )

    def measure(self, click_sel: str) -> dict:
        self.deadline = time.monotonic() + self.args.timeout
        try:
            return self._measure(click_sel)
        except subprocess.TimeoutExpired as exc:
            raise Unresolved("measurement_timeout") from exc
        finally:
            self.deadline = None

    def _measure(self, click_sel: str) -> dict:
        args = self.args
        token = uuid.uuid4().hex[:12]
        script = (
            INSTALL.replace("KEY", json.dumps(self.key))
            .replace("TARGET_SEL", json.dumps(args.target))
            .replace("CLICK_SEL", json.dumps(click_sel))
            .replace("UNTIL_TEXT", json.dumps(args.until_text or ""))
            .replace("ANY_CHANGE", "true" if args.any_change else "false")
            .replace("TOKEN", json.dumps(token))
        )
        installed = as_dict(self.evaluate(script), "install")
        if installed.get("error") == "target-missing":
            raise InstrumentError(f"--target '{args.target}' 在页面上不存在")

        rect = as_dict(
            self.evaluate(
                "(() => { const e = document.querySelector(%s);"
                " if (!e) return JSON.stringify({missing: true});"
                " const r = e.getBoundingClientRect();"
                " return JSON.stringify({w: r.width, h: r.height}); })()" % json.dumps(click_sel)
            ),
            "click-target",
        )
        if rect.get("missing"):
            raise InstrumentError(f"点击目标 '{click_sel}' 不存在")
        if not (finite(rect.get("w"), "click.w") > 0 and finite(rect.get("h"), "click.h") > 0):
            raise InstrumentError(f"点击目标 '{click_sel}' 尺寸为 0，点它等于点空处")

        if self.ab("scrollintoview", click_sel).returncode != 0:
            raise InstrumentError(f"scrollintoview '{click_sel}' 失败")
        if self.ab("click", click_sel).returncode != 0:
            raise InstrumentError(f"click '{click_sel}' 失败")

        observed = False
        while time.monotonic() < self.deadline:
            raw = self.evaluate(
                "JSON.stringify(window[%s] === undefined ? {absent: true} : window[%s])"
                % (json.dumps(self.key), json.dumps(self.key))
            )
            state = as_dict(raw, "state")
            if state.get("absent"):
                # 仪器连同旧 document 一起没了 —— 这是整页导航，不是"这一页很慢"。
                raise Unresolved("unsupported_full_navigation")
            if state.get("token") != token:
                raise InstrumentError("读到的仪器状态不是本次装的（token 不符）")
            if state.get("hit") is False:
                raise InstrumentError(
                    f"点击没有落在 '{click_sel}' 上（composedPath 里没有它）——"
                    "本机 agent-browser 的坐标点击可能被 sticky header / overlay 截走"
                )
            if state.get("gave_up") is True:
                raise Unresolved(state.get("reason") or "endpoint_unverified")
            observed = True
            if state.get("done") is True:
                t0 = finite(state.get("t0"), "t0")
                return {
                    "ms": round(finite(state.get("painted_at"), "painted_at") - t0, 1),
                    "to_change_ms": round(finite(state.get("changed_at"), "changed_at") - t0, 1),
                    "changed": True,
                    "path_before": state.get("path_before"),
                    "path_at_finish": state.get("path_at_finish"),
                }
            # 浏览器中的rAF自行采样；本机只暂停读取，不起一个会耗尽预算的wait子进程。
            time.sleep(min(.25, max(0, self.deadline - time.monotonic())))
        if not observed:
            raise Unresolved("measurement_timeout")
        return {"ms": None, "changed": False, "waited_s": args.timeout}


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="interaction-latency",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    ap.add_argument("url")
    ap.add_argument("--click", required=True, help="要点的那个控件的 CSS 选择器")
    ap.add_argument("--target", default="main", help="他要的那个东西所在的节点，默认 main")
    ap.add_argument(
        "--until-text",
        help="看到这段文字才算到。不给就必须给 --any-change——因为 loading 占位符"
        "本身就是一次'内容变了'，且能稳定很久",
    )
    ap.add_argument(
        "--any-change",
        action="store_true",
        help="文本或不可见→可见变化算到（不代表资源加载完成，中间态可能被计入）",
    )
    ap.add_argument("--noop-click", help="阴性对照要点的控件：一个不该改变任何东西的操作")
    ap.add_argument(
        "--no-negative-control",
        action="store_true",
        help="显式声明不跑阴性对照。退出码固定为 3（未核实），不会伪装成 0",
    )
    ap.add_argument("--viewport", default="1440x900")
    ap.add_argument("--timeout", type=float, default=8.0, help="每次测量从安装到采样结束的总预算（秒，默认8，不含导航）")
    ap.add_argument("--max-ms", type=float, help="cold 或 hot 任一超过它即退出 1")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    if args.until_text and args.any_change:
        ap.error("--until-text 与 --any-change 互斥")
    if args.noop_click and args.no_negative_control:
        ap.error("--noop-click 与 --no-negative-control 互斥")
    if not math.isfinite(args.timeout) or args.timeout <= 0:
        ap.error("--timeout 必须为正有限数")
    if args.max_ms is not None and (not math.isfinite(args.max_ms) or args.max_ms < 0):
        ap.error("--max-ms 必须为非负有限数")

    if not args.until_text and not args.any_change:
        ap.error("要么给 --until-text，要么显式 --any-change（理由见 --help 尾部第 2 条）")
    if not args.noop_click and not args.no_negative_control:
        ap.error("要么给 --noop-click，要么显式 --no-negative-control（后者固定退出 3）")

    if shutil.which("agent-browser") is None:
        print("interaction-latency: 需要 agent-browser，未找到", file=sys.stderr)
        return EXIT_INSTRUMENT
    try:
        w, h = (int(x) for x in args.viewport.lower().split("x"))
        if w <= 0 or h <= 0:
            raise ValueError
    except ValueError:
        print(f"interaction-latency: --viewport 形态错: {args.viewport}", file=sys.stderr)
        return EXIT_INSTRUMENT

    session = f"il-{uuid.uuid4().hex[:8]}"
    probe = Probe(session, args.url, args)
    report: dict = {
        "url": args.url, "click": args.click, "target": args.target,
        "viewport": args.viewport,
        "until": args.until_text if args.until_text else "(--any-change：中间态可能被计入)",
    }
    unresolved_reason: str | None = None

    try:
        probe.set_viewport(w, h)
        # cold 必须先测：阴性对照自己会 open 一次同一 URL，放它前面等于把 cold 预热掉。
        for label in ("cold", "negative", "hot"):
            if label == "negative" and args.no_negative_control:
                report["negative_control"] = "未跑（--no-negative-control）"
                continue
            probe.open_url()
            if label == "cold":
                probe.confirm_viewport(w, h)
            try:
                if label == "negative":
                    neg = probe.measure(args.noop_click)
                    report["negative_control"] = "no_change" if not neg["changed"] else "CHANGED"
                    if neg["changed"]:
                        report["negative_control_ms"] = neg["ms"]
                else:
                    report[label] = probe.measure(args.click)
            except Unresolved as exc:
                unresolved_reason = str(exc)
                report[label] = {"changed": False, "reason": str(exc)}
                if label == "negative":
                    report["negative_control"] = f"未核实（{exc}）"
    except InstrumentError as exc:
        print(f"interaction-latency: {exc}", file=sys.stderr)
        return EXIT_INSTRUMENT
    except subprocess.TimeoutExpired:
        print("interaction-latency: agent-browser 超时", file=sys.stderr)
        return EXIT_INSTRUMENT
    finally:
        try:
            probe.ab("close", timeout=5)
        except Exception:
            print("interaction-latency: session清理未确认，需核该隔离session", file=sys.stderr)

    over = [k for k in ("cold", "hot")
            if args.max_ms is not None and report.get(k, {}).get("ms") is not None
            and report[k]["ms"] > args.max_ms]
    if args.no_negative_control:
        code = EXIT_UNRESOLVED
    elif report.get("negative_control") == "CHANGED" or unresolved_reason:
        code = EXIT_UNRESOLVED
    elif not report.get("cold", {}).get("changed") or not report.get("hot", {}).get("changed"):
        code = EXIT_UNRESOLVED
    elif over:
        code = EXIT_SLOW
    else:
        code = EXIT_OK
    report["over_max_ms"] = over

    if args.json:
        report["exit"] = code
        print(json.dumps(report, ensure_ascii=False, indent=2))
        return code

    print(f"interaction-latency {args.url}")
    print(f"  点击 {args.click} → 目标 {args.target}    视口 {args.viewport}（已读回核实）")
    print(f"  到达判据：{report['until']}")
    if args.until_text:
        print("  量值边界：指定子串出现不证明业务最终态；中间态也含该子串时，本样本的最终态时延未核实")
    for label, zh in (("cold", "冷"), ("hot", "热")):
        r = report.get(label, {})
        if r.get("changed"):
            note = ""
            if r.get("path_before") != r.get("path_at_finish"):
                note = f"（路径 {r['path_before']} → {r['path_at_finish']}，仅诊断）"
            print(f"  {zh}：{r['ms']:.1f} ms（到内容满足条件 {r['to_change_ms']:.1f} ms）{note}")
        elif r.get("reason") == "until_text_preexists":
            print(f"  {zh}：**未核实** —— 点击前已含 --until-text，无法用它证明本次到达；请缩窄判据")
        elif r.get("reason") == "unsupported_full_navigation":
            print(f"  {zh}：**这是一次整页导航** —— 仪器随旧 document 销毁，本工具不覆盖它")
        else:
            print(f"  {zh}：**{r.get('waited_s')} 秒内目标未满足到达判据** —— 不是 0，是没测到")
    print(f"  阴性对照：{report.get('negative_control', '未核实')}")
    if report["negative_control"] == "CHANGED":
        print("    ↑ 一个不该改变任何东西的操作被判成了'到了'——判据太松，本次读数作废")
    elif str(report["negative_control"]).startswith("未跑"):
        print("    ↑ 没跑阴性对照，退出码固定为 3（未核实），不要读成通过")
    if over:
        print(f"  超过 --max-ms={args.max_ms}：{', '.join(over)}")
    print("  不覆盖：这个数准不准（要外部阳性注入：加已知延时后重量，看它是否跟着动）· "
          "遮挡命中测试 · 整页导航 · 首次进入的等待（那是一次导航，归 LCP）")
    return code


if __name__ == "__main__":
    sys.exit(main())
